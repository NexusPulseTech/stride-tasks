# =============================================================================
# Stride Tasks, biến môi trường. Sao chép thành `.env.local` (đã được .gitignore chặn).
# Biến có tiền tố VITE_ được Vite nhúng vào bundle LÚC BUILD → chỉ đặt giá trị CÔNG KHAI ở đó.
# Trên GitHub Actions: khai báo ở Settings → Secrets and variables → Actions → Variables.
# =============================================================================

# Bật paywall PRO. Mặc định tắt: mọi tính năng mở miễn phí và các nút mua bị ẩn.
# Chỉ đặt "true" khi ít nhất một kênh thanh toán bên dưới đã có URL thật.
VITE_ENABLE_PAYWALL=false

# Kênh Việt Nam (199.000₫): ảnh VietQR. Hỗ trợ placeholder {amount} và {orderCode} để tạo QR động, VD:
# https://img.vietqr.io/image/<BANK_BIN>-<SO_TAI_KHOAN>-compact2.png?amount={amount}&addInfo={orderCode}&accountName=<TEN>
VITE_VIETQR_IMAGE_URL=

# Kênh quốc tế: link checkout LemonSqueezy ($25.95) và (tùy chọn) biến thể giá thị trường mới nổi ($14.95).
VITE_LEMONSQUEEZY_CHECKOUT_URL=
VITE_LEMONSQUEEZY_CHECKOUT_URL_EMERGING=

# URL gốc của Cloudflare Worker cấp bản quyền tự động (cloudflare-worker/src/index.js), VD:
# https://tasks-api.nexuspulsetech.xyz
# Để trống → khách nhận link kích hoạt thủ công qua email hỗ trợ.
VITE_LICENSE_CLAIM_URL=

# Đồng bộ đa thiết bị mã hóa đầu-cuối (PRO): URL của cùng Worker trên. Để trống → mục "Đồng bộ thiết bị" bị ẩn.
VITE_SYNC_API_URL=

# Email hỗ trợ hiển thị trong trang mua hàng.
VITE_SUPPORT_EMAIL=support@nexuspulsetech.xyz

# -----------------------------------------------------------------------------
# BÍ MẬT, KHÔNG có tiền tố VITE_, KHÔNG BAO GIỜ được nhúng vào bundle hay commit lên git.
# Tạo bằng: npm run keygen -- init   (lệnh này tự ghi khóa vào .env.local và vá public key vào app)
# -----------------------------------------------------------------------------
# STRIDE_ED25519_PRIVATE_KEY=
