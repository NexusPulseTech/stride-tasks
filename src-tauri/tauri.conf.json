{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stride Tasks",
  "version": "3.1.0",
  "identifier": "com.phucnguyen.stridetasks",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Stride Tasks",
        "width": 1240,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NexusPulse Studio",
    "copyright": "Copyright © 2026 NexusPulse Studio",
    "category": "Productivity",
    "shortDescription": "Personal task manager with Kanban, Pomodoro and SM-2 spaced repetition",
    "longDescription": "Stride Tasks combines a 4-state task workflow, one-line quick capture, a Pomodoro focus timer and SM-2 spaced repetition. It runs 100% offline and keeps all data on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
