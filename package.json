{
  "name": "stride-tasks",
  "private": true,
  "version": "3.1.0",
  "homepage": "https://tasks.nexuspulsetech.xyz/",
  "description": "Ứng dụng quản lý công việc và dự án cá nhân tối giản, Notion-style subtasks, Linear status, Activity Heatmap nhịp độ làm việc, 100% offline local-first.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "keygen": "node scripts/keygen.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "vite build && tauri build"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "4.1.12"
  }
}
